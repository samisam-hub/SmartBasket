# Optional for Step 1. The mock app works with all values empty.
# Use credentials from a separate SmartBasket Supabase project.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key fallback (only needed if not using a publishable key):
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC values are embedded in the app. Never use secret/service_role keys.
