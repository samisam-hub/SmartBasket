{
  "name": "smartbasket",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start --go --lan",
    "android": "expo start --go --android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "doctor": "npx expo-doctor",
    "export:android": "expo export --platform android",
    "test": "node --test tests/*.test.cjs",
    "catalog:prepare": "node scripts/import-catalog.cjs",
    "catalog:apply": "node scripts/apply-catalog.cjs",
    "catalog:verify": "node --env-file=.env scripts/verify-catalog.cjs",
    "basket:verify": "node --env-file=.env scripts/verify-basket.cjs",
    "meals:verify": "node --env-file=.env scripts/verify-meals.cjs",
    "matching:verify": "node --env-file=.env scripts/audit-ingredient-matching.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.115.0",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/react": "~19.1.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  }
}
