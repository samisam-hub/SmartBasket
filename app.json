{
  "expo": {
    "name": "SmartBasket",
    "slug": "smartbasket",
    "version": "0.1.0",
    "scheme": "smartbasket",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": { "package": "com.smartbasket.app", "edgeToEdgeEnabled": true },
    "ios": { "bundleIdentifier": "com.smartbasket.app", "supportsTablet": false },
    "plugins": ["expo-router", "expo-font", "expo-asset", ["expo-audio", {"microphonePermission": "Allow SmartBasket to hear your basket wishes."}]],
    "experiments": { "typedRoutes": true }
  }
}
